# Binaries
/build/
/bin/
*.exe
*.dll
*.so
*.dylib
/main

# Go
vendor/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.env
.pytest_cache/
.mypy_cache/

# Models (downloaded via script)
/models/*
!/models/.keep

# CLI Embedded Assets (copied during build)
/cmd/upscale-cli/assets/bin/*
!/cmd/upscale-cli/assets/bin/.keep
/cmd/upscale-cli/assets/models/*
!/cmd/upscale-cli/assets/models/.keep

# Data (uploads/outputs handled via keepfiles)
/data/uploads/*
!/data/uploads/.keep
/data/outputs/*
!/data/outputs/.keep

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
/logs/
*.log
server_log.txt

# Temp / Generated
/tmp/
/dist/
.task/

# Test Outputs & Generated Data
/test/results/*
!/test/results/.keep
/test/testdata/generated/*
!/test/testdata/generated/.keep
/test/testdata/sample_images/*
!/test/testdata/sample_images/.keep
# Specific legacy/temporary test files at root
test_output.png
test_upscaled.png
*.upscaled.png
*.upscaled.jpg
*.upscaled.webp

# Root level images (usually accidental test output)
/*.webp
/*.png
/*.jpg
/*.json
/*.jpeg
/*.onnx
